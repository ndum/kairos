{
  "name": "kairos",
  "version": "0.0.0",
  "private": true,
  "description": "Know exactly when to leave: a public transport companion for your daily commute in Switzerland.",
  "license": "MIT",
  "author": "Nicolas Dumermuth",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndum/kairos.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan --host",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "test:contract": "vitest run --project contract",
    "check:size": "node scripts/check-bundle-size.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@vueuse/core": "^15.0.0",
    "lean-qr": "^2.7.4",
    "pinia": "^4.0.3",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/tabler": "^1.2.42",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "lefthook": "^2.2.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-browser-vue": "^3.1.0",
    "vue-tsc": "^3.3.12"
  }
}
